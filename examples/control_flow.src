export fn sum_up_to(n: i32) -> i32 {
    let mut sum: i32 = 0;
    let mut i: i32 = 1;
    while (i <= n) {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

export fn count_even(limit: i32) -> i32 {
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while (i < limit) {
        if (i % 2 == 0) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
